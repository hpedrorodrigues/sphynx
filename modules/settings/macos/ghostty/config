# Documentation
#
# ghostty +show-config --default --docs
# https://ghostty.org/docs/config/reference
# https://github.com/search?type=code&q=path%3A%2F%5E.*ghostty.*config%24%2F

### Window
background-opacity = "0.8"
background-blur = "true"

window-padding-x = "8"
window-padding-y = "8"
window-theme = "auto"
window-padding-balance = "true"

confirm-close-surface = "false"
quit-after-last-window-closed = "true"
# Use cmd+shift+click to open links in TMUX (https://github.com/ghostty-org/ghostty/issues/1972#issuecomment-2240048536)
link-url = "true"

### Terminal
command = "/usr/local/bin/zsh --login --interactive -c 'exec sx terminal tmux force-attach sphynx'"

shell-integration = "zsh"
shell-integration-features = "no-cursor,title"

clipboard-read = "allow"
clipboard-write = "allow"
copy-on-select = "true"

### System

macos-option-as-alt = "false"

### Font (ghostty +list-fonts)
font-family = "Fira Code"
font-family-bold = "Fira Code Bold"
font-family-italic = "Fira Code Retina"
font-family-bold-italic = "Fira Code SemiBold"
font-size = "15"

### Colors (ghostty +list-themes)
theme = "Dracula"

### Cursor
cursor-style = "underline"

### Keyboard (ghostty +list-actions)

keybind = "cmd+shift+r=reload_config"

# Switch tmux windows like Chrome tabs.
#
# macOS never passes the cmd key into the terminal byte stream, so tmux can't bind it
# directly. The closest Ghostty can get is "csi:" — send a raw CSI control sequence —
# so we send the sequence a keyboard would produce for shift+alt+left/right, and
# .tmux.conf binds those (S-M-Left/S-M-Right) to previous/next window.
#
# Anatomy of "1;4D" (standard xterm arrow-key encoding):
#   1;4   modifier code: 1 + shift (1) + alt (2) = 4, so "shift+alt"
#   D / C the arrow key itself: D = left, C = right
keybind = "cmd+opt+left=csi:1;4D"
keybind = "cmd+opt+right=csi:1;4C"
