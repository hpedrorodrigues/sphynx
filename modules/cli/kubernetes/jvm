#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

source "${SPHYNX_CLI_DIR}/.internal/all.sh"
source "${SPHYNX_NAMESPACE_DIR}/shared/shared.sh"
source "${SPHYNX_NAMESPACE_DIR}/core/jvm.sh"

##? Generate heap dumps, thread dumps, fiber dumps and native memory reports from JVM processes running in Kubernetes pods
##?
##? Usage:
##?     jvm [<query>] [--selector <selector>] [--namespace <name> | --all-namespaces] [--heapdump] [--threaddump] [--fiberdump] [--nativememory <level>] [--force] [--jdk] [--jdk-image <image>] [--output-dir <path>] [--context <name>]
##?     jvm --namespace <name> --pod <name> --container <name> [--heapdump] [--threaddump] [--fiberdump] [--nativememory <level>] [--force] [--jdk] [--jdk-image <image>] [--output-dir <path>] [--context <name>]
##?
##? Options:
##?     -l --selector <selector>  Selector (label query) to filter on
##?     -n --namespace <name>  The namespace scope for requests
##?     -A --all-namespaces  All namespaces
##?     -p --pod <name>  The pod name
##?     -c --container <name>  The container name
##?     --heapdump  Generate a heap dump
##?     --threaddump  Generate a thread dump
##?     --fiberdump  Generate a Cats Effect 3 fiber dump (via SIGUSR1)
##?     --nativememory <level>  Report the native memory usage of the JVM: summary or detail (requires -XX:NativeMemoryTracking)
##?     --force  Send SIGUSR1 even if the JVM does not appear to handle it (--fiberdump)
##?     --jdk  Run the JDK tooling from an ephemeral container instead of the target container (for JRE-only/distroless images)
##?     --jdk-image <image>  Container image with a full JDK, used by --jdk. Prefer a version equal to or newer than the target JVM [default: eclipse-temurin:21-jdk]
##?     --output-dir <path>  Local directory to store the dump file
##?     --context <name>  The name of the kubeconfig context to use
##?
##? Examples:
##?     jvm
##?     jvm --heapdump
##?     jvm kafka --threaddump
##?     jvm my-app --fiberdump
##?     jvm kafka --nativememory summary
##?     jvm --selector app=kafka --heapdump --output-dir /tmp/dumps
##?     jvm --namespace kafka --pod kafka-0 --container kafka --threaddump
##?     jvm keycloak --heapdump --jdk
##?     jvm keycloak --nativememory detail --jdk
##?     jvm keycloak --threaddump --jdk --jdk-image bellsoft/liberica-openjdk-debian:21
##?     jvm kafka --context staging

sx::parse_arguments "${@}"

readonly generate_heapdump="$(
  [ "${heapdump:-false}" = 'false' ] && [ "${threaddump:-false}" = 'false' ] \
    && [ "${fiberdump:-false}" = 'false' ] && [ -z "${nativememory:-}" ] \
    && echo 'true' \
    || echo "${heapdump:-false}"
)"

sx::k8s::jvm \
  "${query:-}" \
  "${selector:-}" \
  "${namespace:-}" \
  "${pod:-}" \
  "${container:-}" \
  "${generate_heapdump}" \
  "${threaddump:-false}" \
  "${fiberdump:-false}" \
  "${nativememory:-}" \
  "${output_dir:-}" \
  "${all_namespaces:-false}" \
  "${context:-}" \
  "${force:-false}" \
  "${jdk:-false}" \
  "${jdk_image:-}"
